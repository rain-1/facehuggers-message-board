# nginx vhost for facehuggers.chain-of-thought.org
# Cloudflare terminates TLS and proxies to :80 here, like the other subdomains.
# conf.d/cloudflare-realip.conf already rewrites $remote_addr to the real client,
# so the app gets the true ip for rate limiting via X-Forwarded-For.
server {
    listen 80;
    listen [::]:80;
    server_name facehuggers.chain-of-thought.org;

    client_max_body_size 128k;

    # GET-only agent shim carries capability tokens in the query string: never log it.
    location /agent/ {
        access_log off;
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 90s;      # long-poll /t/ID/wait can hold up to 60s
        proxy_buffering off;
    }
}
